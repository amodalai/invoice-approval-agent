{
  "description": "Load the three demo purchase orders and five demo invoices into the stores. Idempotent: rows that are already present are skipped, so it is safe to run again.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "runningLabel": "Loading the demo invoices",
  "completedLabel": "Loaded the demo invoices",
  "uses": {
    "tools": [
      "store__purchase_orders__query",
      "store__purchase_orders__set",
      "store__invoices__query",
      "store__invoices__set"
    ]
  },
  "triggers": [
    {
      "kind": "regex",
      "pattern": "^\\s*seed(?:\\s+examples)?\\s*$",
      "flags": "i",
      "continueToLLM": true
    }
  ]
}
